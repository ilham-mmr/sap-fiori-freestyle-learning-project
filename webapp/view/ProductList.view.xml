<mvc:View
  controllerName="sap.fiori.learning.controller.ProductList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Page
    id="productListPage"
    title="{i18n>productListTitle}"
    busy="{view>/busy}"
    busyIndicatorDelay="0">

    <headerContent>
      <Button
        id="createProductButton"
        icon="sap-icon://add"
        text="{i18n>createProduct}"
        type="Emphasized"
        press=".onOpenCreateDialog" />
    </headerContent>

    <content>
      <VBox class="sapUiSmallMargin">
        <OverflowToolbar id="productToolbar">
          <SearchField
            id="productSearchField"
            width="100%"
            value="{view>/searchText}"
            liveChange=".onSearch"
            search=".onSearch"
            placeholder="{i18n>searchProducts}" />
          <ToolbarSpacer />
          <Button
            id="productSettingsButton"
            icon="sap-icon://action-settings"
            tooltip="{i18n>productSettings}"
            press=".onOpenProductSettings" />
        </OverflowToolbar>

        <!--
          Aggregation binding fills table items from /Products.
          growing=true limits initial rendering and requests more data as needed.
          Stable IDs make tests, support, and UI5 flexibility more reliable.
        -->
        <Table
          id="productTable"
          growing="true"
          growingThreshold="20"
          growingScrollToLoad="true"
          noDataText="{i18n>noProducts}"
          itemPress=".onItemPress"
          items="{
            path: '/Products',
            parameters: {
              $select: 'ID,name,description,price,stock,active'
            },
            sorter: {
              path: 'name'
            }
          }">

          <columns>
            <Column>
              <Text text="{i18n>name}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true">
              <Text text="{i18n>price}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true">
              <Text text="{i18n>stock}" />
            </Column>
            <Column hAlign="Center">
              <Text text="{i18n>status}" />
            </Column>
          </columns>

          <items>
            <ColumnListItem type="Navigation">
              <cells>
                <ObjectIdentifier
                  title="{name}"
                  text="{description}" />
                <ObjectNumber
                  number="{price}"
                  unit="IDR" />
                <ObjectNumber
                  number="{stock}"
                  state="{= ${stock} &lt; 10 ? 'Warning' : 'None' }" />
                <ObjectStatus
                  text="{= ${active} ? ${i18n>active} : ${i18n>inactive} }"
                  state="{= ${active} ? 'Success' : 'Error' }" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
